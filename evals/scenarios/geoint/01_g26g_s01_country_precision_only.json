{
  "id": "g26g_s01_country_precision_only",
  "version": 1,
  "specification": {
    "title": "Country-only input resolves to country precision",
    "description": "Country-only input resolves to the country canonical Location with country precision; no administrative area or city is invented, the exact Evidence is preserved, and the only acceptable verdict is INCONCLUSIVE.",
    "target": "geoint",
    "purpose": "Verify country-only input resolves to the canonical country Location with country precision, inventing neither administrative area nor city, and preserving the exact Evidence.",
    "operational_relevance": "Most free geo sources provide only country granularity; honest precision preservation is essential for downstream trust.",
    "regression_risk": "The resolver could over-resolve to administrative or city precision, or the analyst could emit a verdict beyond inconclusive.",
    "expected_behavior": {
      "required": [
        "The observation resolves to the country Location with country precision",
        "The persisted Evidence row is preserved exactly",
        "The analyst verdict stays inconclusive"
      ],
      "forbidden": [
        "An administrative area or city location is invented from country-only input"
      ]
    },
    "tags": [
      "country-only",
      "geoint",
      "pr26g",
      "precision"
    ],
    "architecture_refs": [
      "resolution-precision-honesty",
      "geographic-support-only"
    ]
  },
