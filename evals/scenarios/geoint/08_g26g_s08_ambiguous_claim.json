  "specification": {
    "title": "Ambiguous claims terminate unresolvable",
    "description": "An ambiguous input (two equally-valued city candidates under the same country) terminates UNRESOLVABLE with no invented Location, observation, or current state.",
    "target": "geoint",
    "purpose": "Verify an ambiguous input with two equally-valued city candidates terminates UNRESOLVABLE with no invented Location, observation, or current state.",
    "operational_relevance": "Ambiguity is real in geocoding; honest unresolvable outcomes beat invented resolutions.",
    "regression_risk": "The resolver could arbitrarily pick one city candidate and fabricate certainty.",
    "expected_behavior": {
      "required": [
        "The ambiguous claim terminates unresolvable",
        "No Location, observation, or current state is invented",
        "The Evidence row remains intact"
      ],
      "forbidden": [
        "An arbitrary city candidate resolves an ambiguous claim"
      ]
    },
