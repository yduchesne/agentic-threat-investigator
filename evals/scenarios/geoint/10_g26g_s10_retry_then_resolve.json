{
  "id": "g26g_s10_retry_then_resolve",
  "version": 1,
  "specification": {
    "title": "Retryable failures retry then resolve",
    "description": "A retryable resolver failure followed by success produces correct attempt/retry semantics and exactly one final geographic truth.",
    "target": "geoint",
    "purpose": "Verify a retryable resolver failure followed by success produces correct attempt and retry semantics and exactly one final geographic truth.",
    "operational_relevance": "Transient geo-provider failures are routine; the retry path must converge on one truth.",
    "regression_risk": "The pipeline could double-persist, exhaust attempts, or leave the observation stuck.",
    "expected_behavior": {
      "required": [
        "The observation resolves after the declared retry semantics",
        "Exactly one final geographic truth is persisted"
      ],
      "forbidden": [
        "Duplicate geographic truths are persisted after the retry"
      ]
    },
    "tags": [
      "geoint",
      "one-final-truth",
      "pr26g",
      "recovery",
      "retry"
    ],
    "architecture_refs": [
      "retry-attempt-semantics"
    ]
  },
