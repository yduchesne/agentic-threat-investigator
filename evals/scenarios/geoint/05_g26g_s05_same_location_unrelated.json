{
  "id": "g26g_s05_same_location_unrelated",
  "version": 1,
  "specification": {
    "title": "Same-location entities stay independent",
    "description": "Two unrelated Entities in the same canonical Location stay independently inspectable; no Relationship is created and geography alone never supports a positive verdict.",
    "target": "geoint",
    "purpose": "Verify two unrelated Entities in the same canonical Location remain independently inspectable with no created Relationship, and geography alone never supports a positive verdict.",
    "operational_relevance": "Co-location is weak evidence in real investigations; preserving independence prevents fabricated linkage.",
    "regression_risk": "The pipeline could create a relationship, or the analyst could infer coordination from shared location alone.",
    "expected_behavior": {
      "required": [
        "Both entities remain independently inspectable",
        "A descriptive shared-location finding is accepted with exact observation support",
        "The analyst verdict stays inconclusive"
      ],
      "forbidden": [
        "A Relationship is created between same-location entities",
        "Geography alone supports a positive verdict"
      ]
    },
    "tags": [
      "geoint",
      "no-relationship",
      "pr26g",
      "same-location",
      "unrelated-entities"
    ],
    "architecture_refs": [
