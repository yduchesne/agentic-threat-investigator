COMPOSE_PROJECT_NAME=ati-dev
ATI_DATA_DIR=/absolute/path/to/ati-data/dev
ATI_POSTGRES_HOST_PORT=54320
POSTGRES_DB=ati
POSTGRES_USER=ati
POSTGRES_PASSWORD=change-me-for-local-use
# Alembic and integration tooling use DATABASE_URL; the API settings contract
# uses the ATI_ prefix.
DATABASE_URL=postgresql+psycopg://ati:change-me-for-local-use@postgres:5432/ati
ATI_DATABASE_URL=postgresql+psycopg://ati:change-me-for-local-use@postgres:5432/ati
ATI_CONFIG_PROFILE=default
ATI_DATABASE_POOL_SIZE=5
ATI_DATABASE_MAX_OVERFLOW=10
ATI_DATABASE_TEST_GUARD=true
ATI_DATABASE_TEST_URL_PATTERN=ati-test
ATI_SESSION_ABSOLUTE_EXPIRY_SECONDS=28800
ATI_SESSION_IDLE_TIMEOUT_SECONDS=
ATI_SESSION_COOKIE_SECURE=false
ATI_LOGIN_RATE_LIMIT_MAXIMUM=5
ATI_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
ATI_PUBLIC_BASE_URL=http://localhost:8000
# Required only for first-run bootstrap; never reset users after creation.
ATI_BOOTSTRAP_ADMIN_USERNAME=
ATI_BOOTSTRAP_ADMIN_PASSWORD=
# Provider HTTP settings
ATI_PROVIDER_TIMEOUT_SECONDS=15.0
ATI_PROVIDER_MAX_RETRIES=2
ATI_PROVIDER_RETRY_BASE_DELAY_SECONDS=1.0
ATI_PROVIDER_RETRY_MAX_DELAY_SECONDS=30.0
ATI_PROVIDER_RETRY_JITTER_RATIO=0.1
ATI_PROVIDER_MAX_RESPONSE_BYTES=2097152
ATI_GOOGLE_DNS_MAX_CONCURRENCY=10
# ATI_GOOGLE_DNS_REQUESTS_PER_SECOND=10  # omit or set >0 to enable rate limiting
ATI_RDAP_MAX_CONCURRENCY=10
# ATI_RDAP_REQUESTS_PER_SECOND=10         # omit or set >0 to enable rate limiting
ATI_RDAP_BOOTSTRAP_CACHE_SECONDS=3600
ATI_IPINFO_LITE_MAX_CONCURRENCY=10
# ATI_IPINFO_LITE_REQUESTS_PER_SECOND=10  # omit or set >0 to enable rate limiting
# Name of the environment variable carrying the IPinfo Lite access token.
# Real token values are resolved from that variable during
# bootstrap/composition and must never be committed to configuration,
# fixtures, or this file. Synthetic placeholder credentials are permitted
# only in isolated deterministic tests.
ATI_IPINFO_LITE_TOKEN_SECRET=ATI_IPINFO_LITE_TOKEN
# Local DB-IP City Lite MMDB artifact location (credential-free file URI).
# Blank/omitted disables the DB-IP City Lite provider entirely. The artifact
# must already exist below ${ATI_DATA_DIR}/datasets at composition time;
# there is no downloader and no DB-IP API key.
# ATI_DBIP_CITY_LITE_ARTIFACT_URI=file:///var/lib/ati/datasets/dbip-city-lite/city-lite.mmdb
# Export the IPinfo Lite access token in the process environment of the
# provider-hosting runtime. Note: pydantic loading of this .env file does
# NOT export the value to the process environment; see docs/DEPLOYMENT.md.
# ATI_IPINFO_LITE_TOKEN=
