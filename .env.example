COMPOSE_PROJECT_NAME=ati-dev
ATI_DATA_DIR=/absolute/path/to/ati-data/dev
# Optional local host-port namespacing (PR 39-10). Set one digit 1..5 to
# publish every host-published ATI service under
# `prefix * 10000 + (default % 10000)`. Prefix 5 gives PostgreSQL 55432,
# Redpanda 59092, API/web 58000, React frontend 58080, Grafana 53000,
# Prometheus 59090, and Jaeger 56686. Empty/unset keeps the standard
# default ports. Explicit ATI_*_HOST_PORT values always win and are never
# prefixed. Only host-published ports change: container ports and
# Compose-network service discovery never do. Use ./start.sh, which resolves
# this before invoking Compose (raw `podman-compose` does not).
ATI_PORT_PREFIX=
POSTGRES_DB=ati
POSTGRES_USER=ati
POSTGRES_PASSWORD=change-me-for-local-use
# Alembic and integration tooling use DATABASE_URL; the API settings contract
# uses the ATI_ prefix.
DATABASE_URL=postgresql+psycopg://ati:change-me-for-local-use@postgres:5432/ati
ATI_DATABASE_URL=postgresql+psycopg://ati:change-me-for-local-use@postgres:5432/ati
ATI_CONFIG_PROFILE=default
# Intelligence-source operating mode (PR 23D): `fake` selects deterministic
# repository-owned fake batch/live sources; `production` selects the real
# configured sources. Independent of ATI_CONFIG_PROFILE and of the LLM.
# Local developer default is fake; production deployments set production.
ATI_OPERATING_MODE=fake
ATI_DATABASE_POOL_SIZE=5
ATI_DATABASE_MAX_OVERFLOW=10
ATI_DATABASE_TEST_GUARD=true
ATI_DATABASE_TEST_URL_PATTERN=ati-test
ATI_SESSION_ABSOLUTE_EXPIRY_SECONDS=28800
ATI_SESSION_IDLE_TIMEOUT_SECONDS=
ATI_SESSION_COOKIE_SECURE=false
ATI_LOGIN_RATE_LIMIT_MAXIMUM=5
ATI_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# V07-01 transitional dual-frontend browser origins. Leave both unset to let
# ./start.sh derive them from the effective host ports: ATI_PUBLIC_BASE_URL
# (React SPA origin accepted for CSRF Origin/Referer validation) follows the
# frontend host port and ATI_WEB_BASE_URL (exact browser origin of the
# server-rendered web adapter served by the same FastAPI process) follows the
# API host port. Both are exact configured origins sharing one session/CSRF
# authority. Explicit values below remain authoritative and are never
# rewritten by the prefix.
# ATI_PUBLIC_BASE_URL=http://localhost:8080
# ATI_WEB_BASE_URL=http://localhost:8000
# Optional explicit host ports. These override ATI_PORT_PREFIX for the named
# service only (and are never prefixed again). Leave them unset to keep the
# standard default or the prefix-derived value. ATI_API_HOST_PORT publishes
# the FastAPI process that serves both /api/v1 and the server-rendered web
# routes.
# ATI_API_HOST_PORT=8000
# ATI_FRONTEND_HOST_PORT=8080
# Geo Resolver process policy (PR 26C/PR L-2): bounded asynchronous
# geographic-resolution worker. The worker id is operational (not a secret/
# authorization identity); a blank id auto-generates a per-process id.
# retry_max_seconds must be >= retry_base_seconds.
# Batch size = rows durably claimed per iteration; max concurrency = how
# many claimed rows are processed simultaneously. Increasing concurrency
# does not always improve throughput: database capacity governs real gain.
ATI_GEO_RESOLVER_ENABLED=true
ATI_GEO_RESOLVER_WORKER_ID=
ATI_GEO_RESOLVER_BATCH_SIZE=10
ATI_GEO_RESOLVER_MAX_CONCURRENCY=4
ATI_GEO_RESOLVER_LEASE_SECONDS=300
ATI_GEO_RESOLVER_POLL_INTERVAL_SECONDS=1.0
ATI_GEO_RESOLVER_MAX_ATTEMPTS=3
ATI_GEO_RESOLVER_RETRY_BASE_SECONDS=60.0
ATI_GEO_RESOLVER_RETRY_MAX_SECONDS=3600.0
# Required only for first-run bootstrap; never reset users after creation.
ATI_BOOTSTRAP_ADMIN_USERNAME=
ATI_BOOTSTRAP_ADMIN_PASSWORD=
# Provider HTTP settings
ATI_PROVIDER_TIMEOUT_SECONDS=15.0
ATI_PROVIDER_MAX_RETRIES=2
ATI_PROVIDER_RETRY_BASE_DELAY_SECONDS=1.0
ATI_PROVIDER_RETRY_MAX_DELAY_SECONDS=30.0
ATI_PROVIDER_RETRY_JITTER_RATIO=0.1
ATI_PROVIDER_MAX_RESPONSE_BYTES=2097152
ATI_GOOGLE_DNS_MAX_CONCURRENCY=10
# ATI_GOOGLE_DNS_REQUESTS_PER_SECOND=10  # omit or set >0 to enable rate limiting
ATI_RDAP_MAX_CONCURRENCY=10
# ATI_RDAP_REQUESTS_PER_SECOND=10         # omit or set >0 to enable rate limiting
ATI_RDAP_BOOTSTRAP_CACHE_SECONDS=3600
ATI_IPINFO_LITE_MAX_CONCURRENCY=10
# ATI_IPINFO_LITE_REQUESTS_PER_SECOND=10  # omit or set >0 to enable rate limiting
# Name of the environment variable carrying the IPinfo Lite access token.
# Real token values are resolved from that variable during
# bootstrap/composition and must never be committed to configuration,
# fixtures, or this file. Synthetic placeholder credentials are permitted
# only in isolated deterministic tests.
ATI_IPINFO_LITE_TOKEN_SECRET=ATI_IPINFO_LITE_TOKEN
ATI_ABUSEIPDB_MAX_CONCURRENCY=10
# ATI_ABUSEIPDB_REQUESTS_PER_SECOND=10  # omit or set >0 to enable rate limiting
ATI_ABUSEIPDB_MAX_AGE_IN_DAYS=30
# Name of the environment variable carrying the AbuseIPDB API key. The
# active _SECRET value is a reference name, not a credential: real key
# values are resolved from that variable during bootstrap/composition and
# must never be committed to configuration, fixtures, or this file.
# Synthetic placeholder credentials are permitted only in isolated
# deterministic tests.
ATI_ABUSEIPDB_API_KEY_SECRET=ATI_ABUSEIPDB_API_KEY
ATI_THREATFOX_MAX_CONCURRENCY=10
# ATI_THREATFOX_REQUESTS_PER_SECOND=10   # omit or set >0 to enable rate limiting
# Name of the environment variable carrying the abuse.ch ThreatFox
# Auth-Key. The active _SECRET value is a reference name, not a credential:
# real key values are resolved from that variable during
# bootstrap/composition and must never be committed to configuration,
# fixtures, or this file. Synthetic placeholder credentials are permitted
# only in isolated deterministic tests.
ATI_THREATFOX_AUTH_KEY_SECRET=ATI_THREATFOX_AUTH_KEY
ATI_URLHAUS_MAX_CONCURRENCY=10
# ATI_URLHAUS_REQUESTS_PER_SECOND=10   # omit or set >0 to enable rate limiting
# Name of the environment variable carrying the abuse.ch URLhaus
# Auth-Key. The active _SECRET value is a reference name, not a credential:
# real key values are resolved from that variable during
# bootstrap/composition and must never be committed to configuration,
# fixtures, or this file. Synthetic placeholder credentials are permitted
# only in isolated deterministic tests.
ATI_URLHAUS_AUTH_KEY_SECRET=ATI_URLHAUS_AUTH_KEY
# Native MISP REST acquisition (PR 32C). Non-secret bounds and the
# API-key secret reference only. The base URL is blank by default: MISP
# is a configured collection datasource that is not wired into the
# production runtime before PR 32D, so an unset URL must stay legal.
# When set, it must be a credential-free HTTPS URL without query or
# fragment (path components such as /misp are preserved exactly).
ATI_MISP_BASE_URL=
ATI_MISP_MAX_CONCURRENCY=4
# ATI_MISP_REQUESTS_PER_SECOND=10   # omit or set >0 to enable rate limiting
ATI_MISP_PAGE_SIZE=100
ATI_MISP_MAX_PAGES=10
# Name of the environment variable carrying the MISP API key. The active
# _SECRET value is a reference name, not a credential: real key values are
# resolved from that variable during bootstrap/composition and must never
# be committed to configuration, fixtures, or this file. Synthetic
# placeholder credentials are permitted only in isolated deterministic
# tests.
ATI_MISP_API_KEY_SECRET=ATI_MISP_API_KEY
# TAXII 2.1 acquisition (PR 33E). TAXII is an explicit acquisition protocol
# (DatasourceProtocol.TAXII_21) feeding the existing STIX 2.1 semantic
# pipeline; it is never a semantic format and never manufactures a STIX
# Bundle. The API-root URL is blank by default (no TAXII datasource, no
# token requirement). When set, it must be a credential-free HTTPS URL
# without query or fragment, the collection ID must be nonblank, and exactly
# one TAXII/STIX datasource definition must exist in settings.datasources
# (the representative OpenCTI profile is provided by default). The bearer
# token is a secret REFERENCE name only; the value is resolved during
# composition and never committed/stored/logged here.
ATI_TAXII_API_ROOT_URL=
ATI_TAXII_COLLECTION_ID=
ATI_TAXII_BEARER_TOKEN_SECRET=ATI_TAXII_BEARER_TOKEN
ATI_TAXII_MAX_CONCURRENCY=4
# ATI_TAXII_REQUESTS_PER_SECOND=10   # omit or set >0 to enable rate limiting
ATI_TAXII_PAGE_SIZE=100
ATI_TAXII_MAX_PAGES=100
# Optional initial added_after cursor: timezone-aware RFC 3339 timestamp,
# used only when no durable per-datasource checkpoint exists yet.
# ATI_TAXII_INITIAL_ADDED_AFTER=2026-01-01T00:00:00Z
# Real LLM driver (PR 20B). `openai` uses the OpenAI-compatible ChatOpenAI
# client; `deterministic` is the repository-owned offline boundary that never
# touches the network or secret values.
ATI_LLM_DRIVER=openai

# Provider-specific model identifier.
ATI_LLM_MODEL=gpt-4o-mini

# Optional OpenAI-compatible API base URL (PR 30A). Non-secret operational
# endpoint selection: leave blank/omitted to use the OpenAI SDK default
# endpoint; a non-blank value must be an HTTP(S) URL without credentials,
# query, or fragment (path components such as /v1 are preserved exactly).
# Example OpenRouter endpoint:
# ATI_LLM_BASE_URL=https://openrouter.ai/api/v1
ATI_LLM_BASE_URL=

# NAME of the environment variable carrying the API key. Holds the NAME of
# the environment variable carrying the key value; never the key itself.
# Default reference: ATI_OPENAI_API_KEY.
ATI_LLM_API_KEY_SECRET=ATI_OPENAI_API_KEY
# LLM tuning references (non-secret); the evidence-analyst input bounds.
ATI_LLM_MAX_STRUCTURED_OUTPUT_ATTEMPTS=2
ATI_LLM_MAX_EVIDENCE_ITEMS=100
ATI_LLM_MAX_RELATIONSHIP_OBSERVATIONS=200
ATI_LLM_MAX_NORMALIZED_FACTS_BYTES=131072
ATI_LLM_MAX_INPUT_BYTES=262144

# OpenRouter example (PR 30A): point the existing openai driver at an
# OpenAI-compatible endpoint and change only the secret reference name.
# Export the actual key value as ATI_OPENROUTER_API_KEY in the runtime
# process environment; never commit a real key.
# ATI_LLM_BASE_URL=https://openrouter.ai/api/v1
# ATI_LLM_MODEL=<openrouter-model-id>
# ATI_LLM_API_KEY_SECRET=ATI_OPENROUTER_API_KEY
# ATI_OPENROUTER_API_KEY=
# Local DB-IP City Lite MMDB artifact location (credential-free file URI).
# Blank/omitted disables the DB-IP City Lite provider entirely. The artifact
# must already exist below ${ATI_DATA_DIR}/datasets at composition time;
# there is no downloader and no DB-IP API key.
# ATI_DBIP_CITY_LITE_ARTIFACT_URI=file:///var/lib/ati/datasets/dbip-city-lite/city-lite.mmdb
# Export the IPinfo Lite access token, the AbuseIPDB API key, and the
# ThreatFox Auth-Key in the process environment of the provider-hosting
# runtime. Note: pydantic loading of this .env file does NOT export values
# to the process environment; see docs/DEPLOYMENT.md.
# ATI_IPINFO_LITE_TOKEN=
# ATI_ABUSEIPDB_API_KEY=
# ATI_THREATFOX_AUTH_KEY=
# ATI_URLHAUS_AUTH_KEY=
# ATI_MISP_API_KEY=
# ATI_OPENAI_API_KEY=

# Observability (PR 29A). Master ATI application-telemetry switch. When
# false (default), no OTel SDK provider is installed and the LLM-
# observability backend always resolves to NoOp, so no vendor credentials
# are required.
ATI_OBSERVABILITY_ENABLED=false
# PR 29C: when observability is enabled here, enabled ATI processes export
# traces/metrics/logs over OTLP/HTTP to exactly one standard destination —
# the OpenTelemetry Collector. Use the standard OTel variable (never an
# ATI-prefixed duplicate); blank keeps the process offline/fail-open.
# With the optional observability Compose stack running:
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# Optional observability host-UIs and settings. These only take effect when
# the observability stack is started (see docs/OBSERVABILITY.md).
# Optional explicit observability host ports; overridden services ignore the
# prefix and the rest keep the default/prefix-derived value.
# ATI_GRAFANA_HOST_PORT=3000
# ATI_PROMETHEUS_HOST_PORT=9090
# ATI_JAEGER_HOST_PORT=16686
# Grafana local admin credentials are environment-overridable; the local
# default is Grafana's own documented local admin/admin and must be
# overridden outside a local developer stack.
# ATI_GRAFANA_ADMIN_USER=admin
# ATI_GRAFANA_ADMIN_PASSWORD=admin
# Typed LLM/agent observability backend selector: exactly one of
# `langsmith`, `langfuse`, or `none` (default). Like ATI_LLM_DRIVER this is
# an environment-resolved operational selection and is never pinned by a
# source-controlled profile. Credentials are required only for the selected
# backend. Standard OpenTelemetry variables (e.g. OTEL_SERVICE_NAME,
# OTEL_EXPORTER_OTLP_ENDPOINT, OTEL_RESOURCE_ATTRIBUTES) are NOT duplicated
# as ATI-prefixed settings; ATI owns observability semantics only.
ATI_LLM_OBSERVABILITY_BACKEND=none
# Langfuse v4 backend configuration. The *_SECRET values are secret
# REFERENCE NAMES (the environment variables carrying the Langfuse public/
# secret keys), never key values; real keys are resolved from those
# variables during composition and must never be committed here. They are
# required only when ATI_LLM_OBSERVABILITY_BACKEND=langfuse. base_url is
# non-secret and optional (SDK default host used when blank); it must not
# embed credentials.
ATI_LANGFUSE_PUBLIC_KEY_SECRET=ATI_LANGFUSE_PUBLIC_KEY
ATI_LANGFUSE_SECRET_KEY_SECRET=ATI_LANGFUSE_SECRET_KEY
# ATI_LANGFUSE_BASE_URL=
# When the Langfuse backend is selected, export the resolved Langfuse keys in
# the process environment of the runtime:
# ATI_LANGFUSE_PUBLIC_KEY=
# ATI_LANGFUSE_SECRET_KEY=
# Optional for explicit ati-eval LangSmith commands (PR 30B): the evaluation
# adapter uses the standard LangSmith environment credentials only when an
# operator runs `ati-eval langsmith sync|verify <dataset-id>`, `ati-eval run
# <dataset-id> --langsmith` (PR 30C), or the manual GitHub workflow. It is
# never required by ordinary CI, never stored in configuration, and never
# logged. Do not conflate it with
# ATI_LLM_OBSERVABILITY_BACKEND=langsmith LLM-observability selection.
# LANGSMITH_API_KEY=
#
# Optional for `ati-eval run evidence-analyst/v1` (PR 30C): the real-model
# benchmark resolves the model-provider key through ATI_LLM_API_KEY_SECRET
# (default reference ATI_OPENAI_API_KEY; see the LLM section above). The
# command refuses ATI_LLM_DRIVER=deterministic; export the resolved key only
# in the process environment of the operator/runner, never here. PR 30D
# extends the same real-model run to coordinator/v1 and research-agent/v1;
# PR 30F extends it to the end-to-end investigation/v1. The configured
# ATI_DATA_DIR must be writable because those benchmark seams
# bootstrap the deterministic research corpus/index there.
