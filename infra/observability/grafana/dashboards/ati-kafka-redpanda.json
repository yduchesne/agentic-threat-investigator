      "type": "text",
      "mode": "markdown",
      "content": "## Kafka / Redpanda\nInfrastructure view of the broker. Lag derives from authoritative Redpanda `/public_metrics` (high watermark minus committed offset); it is never synthesized from ATI counters.",
      "title": ""
    },
    {
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "title": "Aggregate consumer-group lag by topic",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ati-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ati-prometheus"
          },
          "query": "sum(redpanda_kafka_max_offset{redpanda_namespace=\"kafka\"}) by (redpanda_topic) - sum(redpanda_kafka_consumer_group_committed_offset) by (redpanda_topic)",
          "expr": "",
          "instant": false,
          "format": 0,
          "hideEmpty": false,
          "interval": 1,
          "legendFormat": "lag {{redpanda_topic}}",
          "limit": 0,
          "logQuery": "",
          "queryType": "",
          "queryshowhelp": false,
          "useLastPointInGraph": false
        }
      ]
    },
