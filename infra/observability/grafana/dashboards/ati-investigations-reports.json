{
  "uid": "ati-investigations-reports",
  "title": "Investigations & Reports",
  "tags": [
    "ati",
    "observability",
    "investigations"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": [
    {
      "from": "now-30m",
      "to": "now",
      "name": "last 30 minutes"
    },
    {
      "from": "now-1h",
      "to": "now",
      "name": "last 1 hour"
    },
    {
      "from": "now-6h",
      "to": "now",
      "name": "last 6 hours"
    },
    {
      "from": "now-24h",
      "to": "now",
      "name": "last 24 hours"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 1,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "type": "text",
      "mode": "markdown",
      "content": "## Investigations & Reports\nInvestigation execution and report generation operational telemetry, with a compact dependency summary for Agents & LLM. Investigation IDs are never used as dimensions.",
      "title": ""
    },
    {
      "id": 2,
      "gridPos": {
        "h": 3,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "title": "Execution rate & failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ati-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ati-prometheus"
          },
          "expr": "rate(ati_investigation_execute_executed_total[1h])",
          "instant": false,
          "format": 0,
          "hideEmpty": false,
          "interval": 1,
          "legendFormat": "executions/sec",
          "limit": 0,
          "logQuery": "",
          "queryType": "",
          "queryshowhelp": false,
          "useLastPointInGraph": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "ati-prometheus"
          },
          "expr": "increase(ati_investigation_execute_failures_total[1h])",
          "instant": false,
          "format": 0,
          "hideEmpty": false,
          "interval": 1,
          "legendFormat": "failures",
          "limit": 0,
          "logQuery": "",
          "queryType": "",
          "queryshowhelp": false,
          "useLastPointInGraph": false
        }
      ]
    },
    {
      "id": 3,
      "gridPos": {
        "h": 3,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "title": "Execution latency p50/p95/p99 (s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ati-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ati-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum(ati_investigation_execute_duration_seconds_bucket) by (le))",
          "instant": false,
          "format": 0,
          "hideEmpty": false,
          "interval": 1,
          "legendFormat": "p50",
          "limit": 0,
          "logQuery": "",
          "queryType": "",
          "queryshowhelp": false,
          "useLastPointInGraph": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "ati-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(ati_investigation_execute_duration_seconds_bucket) by (le))",
          "instant": false,
          "format": 0,
          "hideEmpty": false,
          "interval": 1,
          "legendFormat": "p95",
          "limit": 0,
          "logQuery": "",
          "queryType": "",
          "queryshowhelp": false,
          "useLastPointInGraph": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "ati-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum(ati_investigation_execute_duration_seconds_bucket) by (le))",
          "instant": false,
          "format": 0,
          "hideEmpty": false,
          "interval": 1,
          "legendFormat": "p99",
          "limit": 0,
          "logQuery": "",
          "queryType": "",
          "queryshowhelp": false,
          "useLastPointInGraph": false
        }
      ]
    },
