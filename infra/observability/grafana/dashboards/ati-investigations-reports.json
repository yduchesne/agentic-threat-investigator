          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "ati-loki"
          },
          "expr": "{service_name=\"ati-worker\"}",
          "luceneQuery": "",
          "queryType": "range",
          "queryStoreMode": "duration",
          "queryRange": "now-1h",
          "queryLimit": 200,
          "queryStep": 15,
          "instant": false
        }
      ],
      "logsSortDirection": "Descending",
      "logMessagePath": "message",
      "logTimePath": "time",
