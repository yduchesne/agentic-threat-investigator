    {
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "type": "text",
      "mode": "markdown",
      "content": "## Agents & LLM\nOperational telemetry for agent invocation, LLM calls, provider execution, and embeddings. This is not an LLM evaluation plane; no prompts, outputs, or chain-of-thought are ever shown.",
      "title": ""
    },
    {
      "id": 2,
      "gridPos": {
        "h": 3,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "title": "Agent failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ati-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ati-prometheus"
          },
          "query": "sum(ati_agent_invoke_failures_total) by (ati_agent)",
          "expr": "",
          "instant": false,
          "format": 0,
          "hideEmpty": false,
          "interval": 1,
          "legendFormat": "{{ati_agent}}",
          "limit": 0,
          "logQuery": "",
          "queryType": "",
          "queryshowhelp": false,
          "useLastPointInGraph": false
        }
      ]
    },
