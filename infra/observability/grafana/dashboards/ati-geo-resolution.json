        "h": 3,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "title": "Worker activity",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ati-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ati-prometheus"
          },
          "query": "rate(ati_geo_resolve_resolved_total[1h])",
          "expr": "",
          "instant": false,
          "format": 0,
          "hideEmpty": false,
          "interval": 1,
          "legendFormat": "resolved rate",
          "limit": 0,
          "logQuery": "",
          "queryType": "",
          "queryshowhelp": false,
          "useLastPointInGraph": false
        },
        {
