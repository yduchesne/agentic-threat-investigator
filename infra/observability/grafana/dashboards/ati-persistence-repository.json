      "type": "text",
      "mode": "markdown",
      "content": "## Persistence / Repository\nATI application persistence view: repository operations, UnitOfWork transactions, and Evidence outcomes. PostgreSQL *server* health stays on the PostgreSQL dashboard.",
      "title": ""
    },
    {
      "id": 2,
      "gridPos": {
        "h": 3,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "title": "Repository failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ati-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ati-prometheus"
          },
          "query": "sum(ati_postgres_repository_failures_total) by (ati_postgres_repository, ati_postgres_operation)",
          "expr": "",
          "instant": false,
          "format": 0,
          "hideEmpty": false,
          "interval": 1,
          "legendFormat": "{{ati_postgres_repository}}.{{ati_postgres_operation}}",
          "limit": 0,
          "logQuery": "",
          "queryType": "",
          "queryshowhelp": false,
          "useLastPointInGraph": false
        }
      ]
    },
